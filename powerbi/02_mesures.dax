// =====================================================================
//  BARÇA ANALYTICS – MESURES DAX
//  À créer dans une table vide nommée « _Mesures »
//  (Accueil > Entrer des données > nommer la table _Mesures > Charger,
//   puis supprimer sa colonne une fois la première mesure créée).
//  Chaque bloc indique le dossier d'affichage (Display folder) conseillé.
//
//  Convention : les mesures d'équipe sont vues du côté du Barça grâce à
//  DimTeam[is_barca]. KEEPFILTERS évite d'écraser un filtre déjà posé
//  par l'utilisateur sur DimTeam.
// =====================================================================


// ---------------------------------------------------------------------
// 📁 1. Résultats
// ---------------------------------------------------------------------

Matchs joués =
COUNTROWS ( DimMatch )

Victoires =
CALCULATE ( [Matchs joués], KEEPFILTERS ( DimMatch[result] = "Victoire" ) )

Nuls =
CALCULATE ( [Matchs joués], KEEPFILTERS ( DimMatch[result] = "Nul" ) )

Défaites =
CALCULATE ( [Matchs joués], KEEPFILTERS ( DimMatch[result] = "Défaite" ) )

% Victoires =
DIVIDE ( [Victoires], [Matchs joués] )
// format : Pourcentage, 0 décimale

Points =
SUM ( DimMatch[points] )

Points par match =
DIVIDE ( [Points], [Matchs joués] )
// format : 0.00

Buts marqués =
SUM ( DimMatch[goals_for] )

Buts encaissés =
SUM ( DimMatch[goals_against] )

Différence de buts =
[Buts marqués] - [Buts encaissés]
// format personnalisé : +0;-0;0

Clean sheets =
CALCULATE ( [Matchs joués], KEEPFILTERS ( DimMatch[goals_against] = 0 ) )


// ---------------------------------------------------------------------
// 📁 2. Expected Goals (équipe)
// ---------------------------------------------------------------------

Tirs =
CALCULATE ( COUNTROWS ( FactShots ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Tirs cadrés =
CALCULATE ( SUM ( FactShots[is_on_target] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Buts sur tirs =
// buts marqués par un tir du Barça (exclut les CSC adverses, d'où un léger écart avec [Buts marqués])
CALCULATE ( SUM ( FactShots[is_goal] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

% Tirs cadrés =
DIVIDE ( [Tirs cadrés], [Tirs] )

Taux de conversion =
DIVIDE ( [Buts sur tirs], [Tirs] )

xG =
CALCULATE ( SUM ( FactShots[xg] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )
// format : 0.0

npxG =
// xG hors penalties : la mesure la plus juste pour juger la création d'occasions
CALCULATE ( [xG], KEEPFILTERS ( FactShots[is_penalty] = 0 ) )

xGA =
// xG concédés : tirs des adversaires
CALCULATE ( SUM ( FactShots[xg] ), KEEPFILTERS ( DimTeam[is_barca] = 0 ) )

Différence xG =
[xG] - [xGA]

xG par tir =
DIVIDE ( [xG], [Tirs] )
// format : 0.00

Buts - xG =
// > 0 : finition au-dessus des attentes ; < 0 : occasions gâchées
[Buts sur tirs] - [xG]
// format personnalisé : +0.0;-0.0;0.0

xG par match =
DIVIDE ( [xG], [Matchs joués] )

xGA par match =
DIVIDE ( [xGA], [Matchs joués] )


// ---------------------------------------------------------------------
// 📁 3. Style de jeu
// ---------------------------------------------------------------------

Possession moyenne =
CALCULATE ( AVERAGE ( FactTeamMatch[possession_pct] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Passes par match =
DIVIDE (
    CALCULATE ( SUM ( FactTeamMatch[passes] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) ),
    [Matchs joués]
)

Précision des passes =
CALCULATE (
    DIVIDE ( SUM ( FactTeamMatch[passes_completed] ), SUM ( FactTeamMatch[passes] ) ),
    KEEPFILTERS ( DimTeam[is_barca] = 1 )
)


// ---------------------------------------------------------------------
// 📁 4. Joueurs (contributions sous le maillot du Barça uniquement)
// ---------------------------------------------------------------------

Minutes jouées =
CALCULATE ( SUM ( FactPlayerMatch[minutes] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )
// format : #,0

Matchs disputés =
CALCULATE ( DISTINCTCOUNT ( FactPlayerMatch[match_id] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Titularisations =
CALCULATE ( SUM ( FactPlayerMatch[is_starter] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Buts joueur =
CALCULATE ( SUM ( FactPlayerMatch[goals] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Passes décisives =
CALCULATE ( SUM ( FactPlayerMatch[assists] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Buts + Passes D =
[Buts joueur] + [Passes décisives]

xG joueur =
CALCULATE ( SUM ( FactPlayerMatch[xg] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

npxG joueur =
CALCULATE ( SUM ( FactPlayerMatch[npxg] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

xA =
// expected assists : somme des xG des tirs que le joueur a servis
CALCULATE ( SUM ( FactPlayerMatch[xa] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

npxG + xA =
[npxG joueur] + [xA]

Passes clés =
CALCULATE ( SUM ( FactPlayerMatch[key_passes] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Passes progressives =
CALCULATE ( SUM ( FactPlayerMatch[progressive_passes] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Courses progressives =
CALCULATE ( SUM ( FactPlayerMatch[progressive_carries] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Passes dans la surface =
CALCULATE ( SUM ( FactPlayerMatch[passes_into_box] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Précision passes joueur =
CALCULATE (
    DIVIDE ( SUM ( FactPlayerMatch[passes_completed] ), SUM ( FactPlayerMatch[passes] ) ),
    KEEPFILTERS ( DimTeam[is_barca] = 1 )
)

% Dribbles réussis =
CALCULATE (
    DIVIDE ( SUM ( FactPlayerMatch[dribbles_completed] ), SUM ( FactPlayerMatch[dribbles] ) ),
    KEEPFILTERS ( DimTeam[is_barca] = 1 )
)

Actions défensives =
CALCULATE (
    SUM ( FactPlayerMatch[tackles_won] ) + SUM ( FactPlayerMatch[interceptions] )
        + SUM ( FactPlayerMatch[ball_recoveries] ),
    KEEPFILTERS ( DimTeam[is_barca] = 1 )
)

Pressions =
CALCULATE ( SUM ( FactPlayerMatch[pressures] ), KEEPFILTERS ( DimTeam[is_barca] = 1 ) )

Tirs créés (via relation inactive) =
// Démontre USERELATIONSHIP : FactShots[assist_player_id] -> DimPlayer[player_id] est une relation INACTIVE
CALCULATE (
    COUNTROWS ( FactShots ),
    USERELATIONSHIP ( FactShots[assist_player_id], DimPlayer[player_id] ),
    KEEPFILTERS ( DimTeam[is_barca] = 1 )
)


// ---------------------------------------------------------------------
// 📁 5. Classements & seuil de minutes
// ---------------------------------------------------------------------
// Prérequis : Modélisation > Nouveau paramètre > Plage numérique
//   Nom : « Minutes minimum », de 0 à 3000, incrément 90, défaut 900.
//   Power BI crée la table 'Minutes minimum' et la mesure [Seuil minutes].

Seuil minutes =
// valeur choisie dans le segment du paramètre (900 min par défaut)
SELECTEDVALUE ( 'Minutes minimum'[Minutes minimum], 900 )

Joueur éligible =
// à placer en filtre de visuel « est 1 » : écarte les joueurs avec trop peu de minutes
IF ( [Minutes jouées] >= [Seuil minutes], 1, 0 )

Rang buts =
IF (
    HASONEVALUE ( DimPlayer[player_id] ),
    RANKX (
        FILTER ( ALLSELECTED ( DimPlayer ), [Minutes jouées] >= [Seuil minutes] ),
        [Buts joueur], , DESC, DENSE
    )
)

Rang npxG + xA par 90 =
IF (
    HASONEVALUE ( DimPlayer[player_id] ),
    RANKX (
        FILTER ( ALLSELECTED ( DimPlayer ), [Minutes jouées] >= [Seuil minutes] ),
        DIVIDE ( [npxG + xA] * 90, [Minutes jouées] ), , DESC, DENSE
    )
)


// ---------------------------------------------------------------------
// 📁 6. Dynamique de saison (intelligence temporelle « par match »)
// ---------------------------------------------------------------------

Points cumulés =
// axe X : DimMatch[matchweek] ; légende : DimMatch[season]
VAR _date   = MAX ( DimMatch[match_date] )
VAR _saison = SELECTEDVALUE ( DimMatch[season] )
RETURN
    IF (
        NOT ISBLANK ( _saison ),
        CALCULATE (
            [Points],
            REMOVEFILTERS ( DimMatch ),
            DimMatch[season] = _saison,
            DimMatch[match_date] <= _date
        )
    )

xG glissant (5 matchs) =
// moyenne mobile des xG sur les 5 derniers matchs de la même saison
VAR _date   = MAX ( DimMatch[match_date] )
VAR _saison = SELECTEDVALUE ( DimMatch[season] )
VAR _5derniers =
    TOPN (
        5,
        FILTER (
            ALL ( DimMatch[match_id], DimMatch[match_date], DimMatch[season] ),
            DimMatch[match_date] <= _date && DimMatch[season] = _saison
        ),
        DimMatch[match_date], DESC
    )
RETURN
    IF (
        NOT ISBLANK ( _saison ),
        CALCULATE ( AVERAGEX ( VALUES ( DimMatch[match_id] ), [xG] ), REMOVEFILTERS ( DimMatch ), _5derniers )
    )

xGA glissant (5 matchs) =
VAR _date   = MAX ( DimMatch[match_date] )
VAR _saison = SELECTEDVALUE ( DimMatch[season] )
VAR _5derniers =
    TOPN (
        5,
        FILTER (
            ALL ( DimMatch[match_id], DimMatch[match_date], DimMatch[season] ),
            DimMatch[match_date] <= _date && DimMatch[season] = _saison
        ),
        DimMatch[match_date], DESC
    )
RETURN
    IF (
        NOT ISBLANK ( _saison ),
        CALCULATE ( AVERAGEX ( VALUES ( DimMatch[match_id] ), [xGA] ), REMOVEFILTERS ( DimMatch ), _5derniers )
    )

Forme (5 derniers) =
// ex. « V V N V D » : les 5 derniers résultats de la sélection, du plus ancien au plus récent
VAR _date = MAX ( DimMatch[match_date] )
VAR _5derniers =
    TOPN (
        5,
        FILTER ( ALLSELECTED ( DimMatch[match_date], DimMatch[result_code] ), DimMatch[match_date] <= _date ),
        DimMatch[match_date], DESC
    )
RETURN
    CONCATENATEX ( _5derniers, DimMatch[result_code], " ", DimMatch[match_date], ASC )


// ---------------------------------------------------------------------
// 📁 7. UX : titres dynamiques & mise en forme conditionnelle
// ---------------------------------------------------------------------

Titre rapport =
"FC Barcelone · Liga " & SELECTEDVALUE ( DimMatch[season], "2018/19 – 2020/21" )

Sous-titre joueur =
VAR _j = SELECTEDVALUE ( DimPlayer[player_name], "Tous les joueurs" )
RETURN
    _j & " · " & FORMAT ( [Minutes jouées], "#,0" ) & " min · "
        & [Matchs disputés] & " matchs"

Couleur résultat =
// Mise en forme conditionnelle > Valeur du champ
SWITCH (
    SELECTEDVALUE ( DimMatch[result_code] ),
    "V", "#1A7F37",
    "N", "#9A6700",
    "D", "#CF222E"
)

Couleur Buts - xG =
IF ( [Buts - xG] >= 0, "#1A7F37", "#CF222E" )


// =====================================================================
//  GROUPE DE CALCUL « Affichage » (optionnel, niveau avancé)
//  Vue Modèle > Groupe de calcul > nom de colonne : Mode
//  Puis réglez la propriété « Discourage implicit measures » si demandé.
// =====================================================================

// Élément 1 – « Total »
SELECTEDMEASURE ()

// Élément 2 – « Par 90 min »
VAR _min = [Minutes jouées]
RETURN
    IF (
        ISSELECTEDMEASURE (
            [Minutes jouées], [Matchs disputés], [Titularisations],
            [Précision passes joueur], [% Dribbles réussis],
            [Rang buts], [Rang npxG + xA par 90]
        ),
        SELECTEDMEASURE (),
        DIVIDE ( SELECTEDMEASURE () * 90, _min )
    )
// Expression de chaîne de format de l'élément « Par 90 min » :
//   IF ( ISSELECTEDMEASURE ( [Minutes jouées] ), "#,0", "0.00" )


// =====================================================================
//  MESURES AJOUTÉES PENDANT LA CONSTRUCTION DU RAPPORT
// =====================================================================

// 📁 4. Joueurs
npxG / 90 =
DIVIDE ( [npxG joueur] * 90, [Minutes jouées] )

xA / 90 =
DIVIDE ( [xA] * 90, [Minutes jouées] )

npxG + xA / 90 =
[npxG / 90] + [xA / 90]

// 📁 7. UX
Couleur Différence xG =
IF ( [Différence xG] >= 0, "#1F5FAD", "#B0124F" )
